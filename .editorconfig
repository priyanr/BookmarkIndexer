root = true

# Code-style rules from the coding guideline that the compiler can check.
# With EnforceCodeStyleInBuild and TreatWarningsAsErrors (Directory.Build.props) each of these fails the build.

[*.cs]
# File-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning

# Block bodies for methods, constructors, operators and local functions (no =>). Lambdas are fine.
csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_operators = false:warning
csharp_style_expression_bodied_local_functions = false:warning
dotnet_diagnostic.IDE0021.severity = warning
dotnet_diagnostic.IDE0022.severity = warning
dotnet_diagnostic.IDE0023.severity = warning
dotnet_diagnostic.IDE0024.severity = warning
dotnet_diagnostic.IDE0061.severity = warning

# Primary constructors
csharp_style_prefer_primary_constructors = true:warning
dotnet_diagnostic.IDE0290.severity = warning

# Collection expressions
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0305.severity = warning

# Remove what your change made unused
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_code_quality_unused_parameters = non_public
dotnet_diagnostic.IDE0060.severity = warning

# "Shared" is a VB keyword, so CA1716 rejects the AppName.Shared namespace. VB interop doesn't matter here.
dotnet_diagnostic.CA1716.severity = none

[**/Model/Migrations/*.cs]
# Written by `dotnet ef migrations add`; style rules would make every new migration fail the build.
generated_code = true

[{*Tests,**/*Tests}/**.cs]
# Test names read as sentences: Order_cannot_be_cancelled_after_shipping
dotnet_diagnostic.CA1707.severity = none

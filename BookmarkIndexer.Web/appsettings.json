{
  "Urls": "http://localhost:5080",
  "ConnectionStrings": {
    "Db": "Host=localhost;Port=5432;Database=bookmarkindexer;Username=postgres;Password=postgres"
  },
  "Lightpanda": {
    "CdpUrl": "ws://127.0.0.1:9222"
  },
  "Ollama": {
    "Url": "http://localhost:11434",
    "EmbeddingModel": "nomic-embed-text"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": {
      "Console": { "Name": "Console" },
      "File": {
        "Name": "File",
        "Args": {
          "path": "Logs/api/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    },
    "Properties": { "Application": "BookmarkIndexer" }
  },
  "AllowedHosts": "*"
}
